{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/config/**/*",
    "src/lang/**/*.json",
    "../panel/plugins/**/*.ts",
    "../panel/plugins/**/*.vue",
    "ant.d.ts",
    "components.d.ts",
    "../common/global.d.ts"
  ],
  "exclude": ["src/**/__tests__/*", "../panel/plugins/*/src/backend/**"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@console/*": ["../panel/plugins/console/src/*"],
      "@instance/*": ["../panel/plugins/instance/src/*"],
      "lodash": ["./node_modules/@types/lodash/index.d.ts"],
      "*": ["./node_modules/*"]
    },
    "moduleResolution": "node",
    "types": ["node"]
  }
}
