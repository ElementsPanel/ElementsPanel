{
  "compilerOptions": {
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2018",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "mcsmanager-common": ["../common/src/index.ts"],
      "*": ["node_modules/*", "src/types/*"],
      "koa": ["node_modules/@types/koa/index.d.ts"],
      "fs-extra": ["node_modules/@types/fs-extra/index.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "plugins/*/src/backend/**/*",
    "../external/*/panel/src/backend/**/*",
    "../common/global.d.ts"
  ]
}
