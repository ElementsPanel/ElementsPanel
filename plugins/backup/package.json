{
  "name": "@elementspanel/epanel-plugin-backup",
  "version": "1.0.5",
  "description": "Instance backup management.",
  "elementspanel": {
    "id": "backup",
    "dual": true,
    "panel": {
      "priority": 150,
      "frontendInject": [
        "console",
        "i18n",
        "instance"
      ],
      "directory": "panel",
      "folder": "backup",
      "description": "Instance backup management."
    },
    "daemon": {
      "priority": 100,
      "directory": "daemon",
      "folder": "backup",
      "description": "Instance backup and restore."
    }
  }
}
