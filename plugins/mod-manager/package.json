{
  "name": "@elementspanel/epanel-plugin-mod-manager",
  "version": "1.0.4",
  "description": "Minecraft mod and plugin management.",
  "elementspanel": {
    "id": "mod-manager",
    "dual": true,
    "panel": {
      "priority": 150,
      "frontendInject": [
        "console",
        "i18n",
        "instance",
        "file"
      ],
      "directory": "panel",
      "folder": "mod",
      "description": "Minecraft mod and plugin management."
    },
    "daemon": {
      "priority": 100,
      "directory": "daemon",
      "folder": "mod",
      "description": "Instance mod and plugin management."
    }
  }
}
